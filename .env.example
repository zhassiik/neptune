# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Тек серверде қолданылады. Ешқашан NEXT_PUBLIC_ префиксімен жазбаңыз!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Сайттың толық адресі (email растау сілтемелері үшін)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Cloudflare Stream (қорғалған видео-талдаулар). Барлығы тек серверде!
# ---------------------------------------------------------------------
# Cloudflare Dashboard → оң жақтағы Account ID
CLOUDFLARE_ACCOUNT_ID=
# My Profile → API Tokens → Create Token → «Stream: Edit» рұқсатымен
CLOUDFLARE_API_TOKEN=
# Stream → кез келген видео → Embed: https://customer-<CODE>.cloudflarestream.com → тек <CODE> бөлігі
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# `npm run cf:signing-key` командасы шығарған мәндер
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=
# Production домені (allowedOrigins үшін), мысалы: https://neptune-ubt.kz
NEXT_PUBLIC_APP_URL=
# Қосымша рұқсат етілетін домендер (міндетті емес), үтір арқылы: 192.168.0.107:3000,staging.neptune-ubt.kz
CLOUDFLARE_STREAM_EXTRA_ORIGINS=

# ---------------------------------------------------------------------
# Құрылғы бақылауы
# ---------------------------------------------------------------------
# Бір аккаунтқа рұқсат етілген құрылғы саны (1–20). Бос болса — админ-панельдегі мән (әдепкі 4)
MAX_DEVICES_PER_USER=

# Optional: Cloudflare Turnstile CAPTCHA (3 сәтсіз кіруден кейін сұралады)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: жаңа құрылғыдан кіру туралы email (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=
